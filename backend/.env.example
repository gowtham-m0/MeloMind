# Copy to backend/.env and fill in. Never commit .env.
# Empty values fall back to the defaults in app/core/settings.py.

# App and database. DATABASE_URL uses the asyncpg driver, e.g. Supabase's session pooler:
# postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Leave it empty to keep data in memory (lost on restart).
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=

# Supabase: https://<project-ref>.supabase.co. Needed to verify sign-in tokens.
SUPABASE_URL=

# Qloo (leave QLOO_API_KEY empty to use the demo fixtures)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# YouTube (optional: the Preview button in an item's detail view; hidden when empty)
YOUTUBE_API_KEY=

# Songs: Apple's iTunes Search API, no key. Set to false to turn the songs row off at once
# (Apple's terms ask us to remove its content on request).
SONGS_ENABLED=true

# LLM: Gemini is the main model, Groq the fallback when Gemini times out or fails.
# Groq's free tier (8,000 tokens a minute) is too small to be the main model.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_API_KEY=
# Speech to text for spoken journal entries (Groq Whisper, uses the Groq key above)
STT_MODEL=whisper-large-v3-turbo

# Agent and limits
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_CALLS=8
AGENT_TIMEOUT_SECONDS=25
RESOLVE_MAX_SEARCHES=5
LINK_MAX_SEARCHES=10
AGENT_MAX_RETRIES=2
FEED_MAX_QLOO_CALLS=24
FEED_RATE_LIMIT_PER_HOUR=20

# Feed, quiz and taste map
FEED_ROW_SIZE=12
QUIZ_PAIRS=6
TASTE_MAP_MAX_NODES=40
