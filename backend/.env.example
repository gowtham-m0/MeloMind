# Copy to backend/.env and fill in. Never commit .env.
# Empty values fall back to the defaults in app/core/settings.py.

# App and database
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=

# Supabase
SUPABASE_URL=

# Qloo (leave QLOO_API_KEY empty to use the demo fixtures)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# YouTube
YOUTUBE_API_KEY=

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Agent and limits
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_CALLS=8
AGENT_TIMEOUT_SECONDS=25
RESOLVE_MAX_SEARCHES=5
LINK_MAX_SEARCHES=10
AGENT_MAX_RETRIES=2
SESSION_TARGET_MINUTES=20
PLAN_RATE_LIMIT_PER_HOUR=10

# Person mode and Memory Graph
WARMUP_PAIRS=6
MEMORY_GRAPH_MAX_NODES=30
